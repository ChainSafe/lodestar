+static bool ParseReadLimits (napi_env env, napi_value options, ReadLimits& limits) {
+  napi_value object, value;
+  if (napi_get_named_property(env, options, "readLimits", &object) != napi_ok) return false;
+  napi_valuetype type;
+  napi_value nullValue;
+  bool isNull;
+  if (napi_typeof(env, object, &type) != napi_ok || type != napi_object ||
+      napi_get_null(env, &nullValue) != napi_ok || napi_strict_equals(env, object, nullValue, &isNull) != napi_ok || isNull) return false;
+  const char* names[] = {"maxKeyBytes", "maxValueBytes", "maxTotalBytes", "maxEntries"};
+  size_t caps[] = {boundedMaxKeyBytes, boundedMaxBytes, boundedMaxBytes, boundedMaxKeys};
+  size_t* fields[] = {&limits.key, &limits.value, &limits.total, &limits.entries};
+  for (size_t i = 0; i < 4; i++) {
+    if (napi_get_named_property(env, object, names[i], &value) != napi_ok ||
+        !ExactPositive(env, value, caps[i], *fields[i])) return false;
+  }
+  return limits.entries <= SIZE_MAX / limits.key &&
+    limits.total <= SIZE_MAX - limits.entries * limits.key;
+}
