+
+function boundedProjection (Base, keys) {
+  return class extends Base {
+    constructor (db, options) {
+      const iterator = db.iterator({ ...options, keys, values: !keys })
+      try {
+        if (db.status !== 'open') throw new ModuleError('Database is not open', { code: 'LEVEL_DATABASE_NOT_OPEN' })
+        super(db, options)
+      } catch (err) {
+        iterator.close(() => {})
+        throw err
+      }
+      this[kInner] = iterator
+    }
+
+    _next (callback) {
+      this[kInner].next((err, key, value) => callback(err, keys ? key : value))
+    }
+
+    _nextv (size, options, callback) {
+      this[kInner].nextv(size, options, (err, rows) => {
+        if (err) callback(err)
+        else callback(null, rows.map(row => row[keys ? 0 : 1]))
+      })
+    }
+
+    _seek (target, options) {
+      this[kInner].seek(target, options)
+    }
+
+    _close (callback) {
+      this[kInner].close(callback)
+    }
+  }
+}
+
+exports.BoundedKeyIterator = boundedProjection(AbstractKeyIterator, true)
+exports.BoundedValueIterator = boundedProjection(AbstractValueIterator, false)
