+  static void Execute (napi_env, void* data) {
+    BoundedGetWorker* self = static_cast<BoundedGetWorker*>(data);
+    leveldb::Iterator* iterator = self->database->NewIterator(&self->options);
+    size_t total = 0;
+    for (size_t i = 0; i < self->count; i++) {
+      BoundedRecord& row = self->records[i];
+      leveldb::Slice key(row.keySize == 0 ? "" : self->keys.data + row.keyOffset, row.keySize);
+      iterator->Seek(key);
+      if (!iterator->status().ok()) { self->error = iterator->status().IsCorruption() ? "LEVEL_CORRUPTION" : "LEVEL_IO_ERROR"; break; }
+      if (!iterator->Valid() || iterator->key().compare(key) != 0) continue;
+      size_t size = iterator->value().size();
+      if (size > self->limits.value || size > self->limits.total - total) {
+        self->error = ReadLimit; break;
+      }
+      row.found = true;
+      row.valueOffset = total;
+      row.valueSize = size;
+      total += size;
+    }
+    if (self->error == NULL && !self->values.Allocate(total)) self->error = AllocationFailure;
+    if (self->error == NULL) {
+      for (size_t i = 0; i < self->count; i++) {
+        BoundedRecord& row = self->records[i];
+        if (!row.found) continue;
+        leveldb::Slice key(row.keySize == 0 ? "" : self->keys.data + row.keyOffset, row.keySize);
+        iterator->Seek(key);
+        if (!iterator->status().ok()) { self->error = iterator->status().IsCorruption() ? "LEVEL_CORRUPTION" : "LEVEL_IO_ERROR"; break; }
+        if (!iterator->Valid() || iterator->key().compare(key) != 0 || iterator->value().size() != row.valueSize) {
+          self->error = "LEVEL_CORRUPTION"; break;
+        }
