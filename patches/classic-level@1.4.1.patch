+    if (status != napi_ok) self->error = AllocationFailure;
+    if (self->single && !self->records[0].found && self->error == NULL) self->error = "LEVEL_NOT_FOUND";
+    if (self->error == NULL && napi_create_array_with_length(env, self->count, &array) != napi_ok) self->error = AllocationFailure;
+    for (size_t i = 0; self->error == NULL && i < self->count; i++) {
+      BoundedRecord& row = self->records[i];
+      napi_value value;
+      napi_status conversion = row.found
+        ? BoundedConvert(env, row.valueSize == 0 ? "" : self->values.data + row.valueOffset, row.valueSize, value)
+        : napi_get_undefined(env, &value);
+      if (conversion != napi_ok || napi_set_element(env, array, i, value) != napi_ok) self->error = AllocationFailure;
+    }
+    self->keys.Clear();
+    self->values.Clear();
+    self->database->ReleaseSnapshot(self->options.snapshot);
+#ifdef CLASSIC_LEVEL_BOUNDED_TEST
+    boundedSnapshots.fetch_sub(1);
+#endif
+    if (self->error != NULL) BoundedCallbackError(env, callback, self->error);
+    else {
