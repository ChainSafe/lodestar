  "panels": [
    {
      "id": 11,
      "type": "text",
      "title": "About - native BLS verifier (supplement)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Native BLS verifier signals with **no legacy `bls_thread_pool_*` analogue** (these did not exist in the worker_threads pool). The cross-architecture signals (sig sets, queue length, workers busy, errors, retries, success/started counts, main-thread time) are emitted under the **legacy `lodestar_bls_thread_pool_*` names** and appear on the standard **BLS Thread Pool / Summary / Networking / Block Processor** dashboards \u2014 compare native vs unstable there by filtering on `instance`. This board only covers the native-exclusive internals."
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Native worker pool - occupancy",
      "collapsed": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Pool occupancy",
      "description": "active = in-flight (queued+running+settling); workers_total = pool size; max_inflight = capacity. (queue_length / workers_busy are on the standard BLS dashboard under the legacy names.)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "lodestar_bls_verifier_active_jobs",
          "interval": "",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "lodestar_bls_verifier_workers_total",
          "interval": "",
          "legendFormat": "workers_total",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "lodestar_bls_verifier_max_inflight_jobs",
          "interval": "",
          "legendFormat": "max_inflight",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "lodestar_bls_verifier_inflight_jobs",
          "interval": "",
          "legendFormat": "inflight (JS, post fan-out)",
          "refId": "D"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Errored sig sets / sec by class",
      "description": "From lodestar_bls_thread_pool_error_jobs_signature_sets_count (native adds the {type} label). operational = pool backpressure/shutdown -> gossip Ignore; input = malformed/crypto -> false. A genuine invalid-signature verdict is NOT counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
