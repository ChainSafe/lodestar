{
  "extends": "./tsconfig.common.json",
  "compilerOptions": {
    "rootDir": "${configDir}",
    "emitDeclarationOnly": false,
    "incremental": false,
    "noEmit": true,
    // To be used in the test fixtures
    "resolveJsonModule": true,
    // We want to speed up the CI run for all tests, which require us to transpile
    // each `.ts` file independently (e.g. via `tsx`). This requires treating types
    // for each module independently, which is done by setting `isolatedModules` to `true`.
    "isolatedModules": true,
    // Detect unused imports, variables, and functions
    "noUnusedLocals": true
  }
}
